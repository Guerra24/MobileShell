<Grid
    x:Class="MobileShell.Views.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MobileShell.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Loaded="StatusBar_Loaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

	<Grid.RowDefinitions>
		<RowDefinition />
		<RowDefinition Height="36" />
	</Grid.RowDefinitions>

	<Grid Background="Black" Tapped="OneHandedGrid_Tapped">
		<TextBlock Text="Tap here to exit one-handed use. Press and hold the Start button to activate." HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="32" Style="{ThemeResource CaptionTextBlockStyle}" FontSize="14" Foreground="White" />
	</Grid>

	<Grid Grid.Row="1" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
		<Grid.Resources>
			<Style TargetType="FontIcon">
				<Setter Property="FontSize" Value="16"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
				<Setter Property="HorizontalAlignment" Value="Center"/>
			</Style>
		</Grid.Resources>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition/>
			<ColumnDefinition/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<StackPanel Orientation="Horizontal" Padding="12,0,0,0">
			<Grid x:Name="airplaneGrid" Width="16" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="airplaneGlyph" Glyph="&#xEC40;" />
			</Grid>

			<Grid x:Name="sim1Grid" Width="16" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="sim1SignalStatus" Glyph="&#xE871;" Visibility="Collapsed" />
				<FontIcon x:Name="sim1Signal" Glyph="&#xE86C;" Visibility="Collapsed" />
				<FontIcon x:Name="sim1Back" Opacity="0.5" Glyph="&#xEC3B;" Visibility="Collapsed" />
				<FontIcon x:Name="sim1Dual" Glyph="&#xE884;" Visibility="Collapsed" />
				<FontIcon x:Name="sim1Glyph" Glyph="&#xE876;" Visibility="Collapsed" />
			</Grid>

			<Grid x:Name="sim2Grid" Width="16" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="sim2SignalStatus" Glyph="&#xE871;" Visibility="Collapsed" />
				<FontIcon x:Name="sim2Signal" Glyph="&#xE86C;" Visibility="Collapsed" />
				<FontIcon x:Name="sim2Back" Opacity="0.5" Glyph="&#xEC3B;" Visibility="Collapsed" />
				<FontIcon x:Name="sim2Dual" Glyph="&#xE882;" Visibility="Collapsed" />
				<FontIcon x:Name="sim2Glyph" Glyph="&#xE876;" Visibility="Visible" />
			</Grid>

			<Grid x:Name="roamingGrid" Visibility="Collapsed">
				<FontIcon x:Name="roamingGlyph" Glyph="&#xE878;" Margin="0,0,0,2" />
			</Grid>

			<Grid Margin="0,0,12,0" ToolTipService.ToolTip="{x:Bind Data.NetworkIconInfo.ToolTipText, Mode=OneWay}">
				<FontIcon Glyph="{x:Bind Data.NetworkIconInfo.BackgroundGlyph, Mode=OneWay}" Opacity="0.5" />
				<FontIcon Glyph="{x:Bind Data.NetworkIconInfo.MiddleGlyph, Mode=OneWay}" />
				<FontIcon Glyph="{x:Bind Data.NetworkIconInfo.ForegroundGlyph, Mode=OneWay}" />
			</Grid>

			<Grid x:Name="tetheringGrid" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="tetheringGlyph"  Glyph="&#xEC44;"/>
			</Grid>

			<Grid x:Name="ethernetGrid" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="ethernetGlyph"  Glyph="&#xE839;"/>
			</Grid>

			<Grid x:Name="vpnGrid" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="vpnGlyph"  Glyph="&#xE705;"/>
			</Grid>

			<Grid x:Name="vibrateRingGrid" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="vibrateRingGlyph"  Glyph="&#xE877;" />
			</Grid>

			<Grid x:Name="focusGrid" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="focusGlyph" Glyph="&#xEC46;" />
			</Grid>

			<Grid Margin="0,0,12,0" Visibility="{x:Bind Data.DoNotDisturb, Mode=OneWay}">
				<FontIcon Glyph="&#xF4BD;" />
			</Grid>

			<Grid x:Name="locationGrid" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="locationGlyph"  Glyph="&#xEC43;" />
			</Grid>

			<Grid Margin="0,0,12,0" Visibility="{x:Bind Data.BluetoothEnabled, Mode=OneWay}">
				<FontIcon Glyph="&#xEC41;" />
			</Grid>

			<Grid x:Name="notificationGrid" Margin="3,0" Visibility="Collapsed">
				<FontIcon x:Name="notificationGlyph" Glyph="&#xEC42;"/>
			</Grid>

		</StackPanel>

		<StackPanel Orientation="Horizontal" Grid.Column="3" Padding="0,0,12,0">
			<StackPanel Visibility="{x:Bind Data.BatteryIconData.IsBatteryPresent, Mode=OneWay}" Spacing="12" Margin="12,0,0,0">
				<TextBlock FontSize="15" VerticalAlignment="Center">
					<Run Text="{x:Bind Data.BatteryIconData.BatteryPercentage, Mode=OneWay}"/>%
				</TextBlock>

				<Grid VerticalAlignment="Center">
					<FontIcon Glyph="{x:Bind Data.BatteryIconData.FillGlyph, Mode=OneWay}" Foreground="{x:Bind Data.BatteryIconData.FillColor, Mode=OneWay, Converter={StaticResource BatteryIconFillColorConverter}}" />
					<FontIcon Glyph="{x:Bind Data.BatteryIconData.OutlineGlyph, Mode=OneWay}" />
				</Grid>
			</StackPanel>

			<TextBlock x:Name="Clock" FontSize="19.5" Text="{x:Bind Data.Clock, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0,0,0" />
		</StackPanel>
		<Button Grid.ColumnSpan="2" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource TextBlockButtonStyle}" Command="{x:Bind Data.ActionCenterCommand}" />
		<Button Grid.Column="2" Grid.ColumnSpan="2" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource TextBlockButtonStyle}" Command="{x:Bind Data.ControlCenterCommand}" />
	</Grid>

</Grid>
